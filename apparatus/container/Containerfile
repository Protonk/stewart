# Stewart build toolchain: the pinned Rust image plus the native musl target
# and musl C toolchain (ring compiles C and assembly for the target).
# Built once per platform by apparatus/step2.sh; the resulting image digest is
# the toolchain pin recorded with each build.
FROM docker.io/library/rust@sha256:81015672d6939b0265f09adf96d5de125482bb1330106076956b0518e74edc90
RUN set -eu; \
    arch="$(uname -m)"; \
    rustup target add "${arch}-unknown-linux-musl"; \
    apt-get update; \
    apt-get install -y --no-install-recommends musl-tools; \
    rm -rf /var/lib/apt/lists/*; \
    { rustc -vV; cargo -V; rustup target list --installed; \
      dpkg-query -W musl-tools musl musl-dev; musl-gcc --version | head -1; } \
      > /toolchain-versions.txt
