#!python
"""Console companion: establish a fresh cache before importing Stewart."""
import sys
if not sys.flags.isolated or not sys.dont_write_bytecode:
    raise SystemExit("use the isolated stewart console launcher")
import tempfile
with tempfile.TemporaryDirectory(prefix="stewart-console-") as stewart_cache:
    sys.pycache_prefix = stewart_cache
    from pathlib import Path
    import runpy
    import sysconfig
    stewart_bootstrap = Path(sysconfig.get_path("purelib")) / "stewart/_bootstrap.py"
    sys.argv = [str(stewart_bootstrap), "source", "--", *sys.argv[1:]]
    runpy.run_path(str(stewart_bootstrap), run_name="__main__")
